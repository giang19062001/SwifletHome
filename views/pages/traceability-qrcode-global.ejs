<% if (values && values.traceData) { %>
<% const data = values.traceData; %>
<% const isExternal = Boolean(data.isExternal); %>
<% const compact = data.compactData %>
<script>
  console.log('traceData:', <%- JSON.stringify(data) %>);
  console.log('isExternal:', <%- JSON.stringify(isExternal) %>);
  console.log('compactData:', <%- JSON.stringify(compact) %>);
</script>
<div class="page-qrcode-update py-3 py-md-4" id="qrcode-global-content">
    <!-- Nút tải PDF nổi góc dưới màn hình -->
    <div class="pdf-floating-btn" data-html2canvas-ignore="true">
        <a
            href="/api/app/traceability/downloadPdf/<%= data.traceabilityId %>"
            class="btn btn-danger shadow-lg rounded-pill px-4 py-2 d-flex align-items-center text-white text-decoration-none"
            id="btn-download-pdf"
        >
            <i class="fa fa-file-pdf me-2 fa-lg"></i>
            <span class="fw-bold">Tải bản PDF</span>
        </a>
    </div>

    <div class="trace-container" style="max-width: 900px; margin: 0 auto; padding: 0 16px;">
        <!-- Banner Header: Định danh & Huy hiệu xác thực -->
        <div class="card border-0 shadow-sm overflow-hidden mb-4 d-none" style="background: linear-gradient(135deg, #71AB33 0%, #4B7A1C 100%);">
            <div class="card-body p-4 text-white">
                <div class="d-flex flex-wrap align-items-center justify-content-between gap-3">
                    <div class="d-flex align-items-center">
                        <div class="bg-white text-success rounded-circle p-3 d-flex align-items-center justify-content-center me-3 shadow-sm" style="width: 58px; height: 58px;">
                            <i class="fa fa-shield-alt fa-2x" style="color: #71AB33;"></i>
                        </div>
                        <div>
                            <span class="badge bg-white text-success fw-bold px-2 py-1 mb-1">
                                <i class="fa fa-check-circle me-1"></i> ĐÃ XÁC THỰC HỆ THỐNG
                            </span>
                            <h3 class="mb-0 fw-bold fs-4 text-white">  
                                <%= isExternal
                                    ? 'TRUY XUẤT NGUỒN GỐC SẢN PHẨM'
                                    : 'TRUY XUẤT NGUỒN GỐC TỔ YẾN' %></h3>
                            <p class="mb-0 text-white-50 small">
                                  <%= isExternal
                                    ? 'Hồ sơ điện tử truy xuất sản phẩm'
                                    : 'Hồ sơ điện tử truy xuất tổ yến' %>
                                </p>
                        </div>
                    </div>
                    <div>
                        <a href="/api/app/traceability/downloadPdf/<%= data.traceabilityId %>" class="btn btn-light text-success fw-bold px-3 py-2 rounded-pill shadow-sm">
                            <i class="fa fa-file-pdf me-1 text-danger"></i> Xuất chứng nhận PDF
                        </a>
                    </div>
                </div>

                <hr class="my-3 border-white opacity-25">

                <div class="row g-2 text-white small">
                    <div class="col-12 col-md-6">
                        <span class="text-white-50">Mã tra cứu TXNG:</span>
                        <span class="fw-bold ms-1 text-break"><%= data.traceabilityId %></span>
                    </div>
                    <div class="col-12 col-md-6">
                        <span class="text-white-50">Mã lô sản phẩm:</span>
                        <span class="fw-bold ms-1 text-warning"><%= data.lotcode || compact.lotcode || 'Chưa cập nhật' %></span>
                    </div>
                </div>
            </div>
        </div>

        <% if (!isExternal) { %>
            <!-- ========================================== -->
            <!-- TRUY XUẤT NỘI BỘ (INTERNAL) -->
            <!-- ========================================== -->

            <!-- Thẻ 1: Thông tin cơ sở -->
            <div class="card border-0 shadow-sm mb-4">
                <div class="card-header bg-white py-3 border-bottom d-flex align-items-center d-none">
                    <div class="icon-box me-3">
                        <i class="fa fa-home fa-lg"></i>
                    </div>
                    <h5 class="mb-0 fw-bold text-dark">Thông tin cơ sở</h5>
                </div>
                <div class="card-body p-3 p-md-4">
                    <div class="row g-3">
                        <div class="col-12">
                            <div class="field-container">
                                <div class="field-label text-muted small">Tên chủ nhà yến</div>
                                <div class="field-value fw-bold fs-6">
                                    <%= compact.personInCharge || data.homeInfo?.userName || '-' %>
                                </div>
                            </div>
                        </div>
                        <div class="col-12">
                            <div class="field-container">
                                <div class="field-label text-muted small">Mã định danh nhà yến do bộ Nông Nghiệp cấp</div>
                                <div class="field-value fw-bold fs-6 text-primary">
                                    <%= compact.fiIdentificationCode || '-' %>
                                </div>
                            </div>
                        </div>
                        <div class="col-12">
                            <div class="field-container">
                                <div class="field-label text-muted small">Địa chỉ</div>
                                <div class="field-value">
                                    <%= compact.facilityAddress || data.homeInfo?.userHomeAddress || '-' %>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Thẻ 2: Thông tin thu hoạch -->
            <div class="card border-0 shadow-sm mb-4">
                <div class="card-header bg-white py-3 border-bottom d-flex align-items-center d-none">
                    <div class="icon-box me-3">
                        <i class="fa fa-boxes fa-lg"></i>
                    </div>
                    <h5 class="mb-0 fw-bold text-dark">Thông tin thu hoạch</h5>
                </div>
                <div class="card-body p-3 p-md-4">
                    <div class="row g-3">
                        <div class="col-12">
                            <div class="field-container">
                                <div class="field-label text-muted small">Mã lô</div>
                                <div class="field-value fw-bold text-dark">
                                    <%= compact.lotcode || data.lotcode || '-' %>
                                </div>
                            </div>
                        </div>

                        <div class="col-12">
                            <div class="field-container">
                                <div class="field-label text-muted small">Ngày thu hoạch</div>
                                <div class="field-value fw-bold fs-6">
                                    <%= compact.hiHarvestDate || '-' %>
                                </div>
                            </div>
                        </div>

                        <% if (compact.hmWeightingPhoto) { %>
                            <% const photoUrl = typeof compact.hmWeightingPhoto === 'object' ? compact.hmWeightingPhoto?.url : compact.hmWeightingPhoto; %>
                            <% if (photoUrl) { %>
                                <div class="col-12 mt-3">
                                    <div class="field-label text-muted small mb-2 fw-bold">Hình ảnh thu hoạch:</div>
                                    <a href="/<%= photoUrl %>" target="_blank" class="d-block text-center">
                                        <img src="/<%= photoUrl %>" alt="Ảnh tổ yến thu hoạch" class="img-thumbnail rounded shadow-sm w-100" style="max-height: 380px; object-fit: contain;">
                                    </a>
                                </div>
                            <% } %>
                        <% } %>
                    </div>
                </div>
            </div>

            <!-- Thẻ 3: Nhật ký nhà yến (Công việc) -->
            <div class="card border-0 shadow-sm mb-4">
                <div class="card-header bg-white py-3 border-bottom d-flex align-items-center d-none">
                    <div class="icon-box me-3">
                        <i class="fa fa-book fa-lg"></i>
                    </div>
                    <h5 class="mb-0 fw-bold text-dark">Nhật ký chăm sóc nhà yến</h5>
                </div>
                <div class="card-body p-3 p-md-4">
                    <div>
                        <% const todoField = compact.todoListGroup?.fields?.find(f => (f.fieldKey || '').toLowerCase().includes('todo') || f.fieldType === 'list_canwrite'); %>
                        <% const todoItems = todoField?.currentValue; %>
                        <% const todoSubFields = (todoField?.config && (Array.isArray(todoField.config.maps) ? todoField.config.maps : (Array.isArray(todoField.config.fields) ? todoField.config.fields : []))) || []; %>
                        <% if (Array.isArray(todoItems) && todoItems.length > 0) { %>
                            <div class="table-responsive">
                                <table class="table table-bordered table-sm align-middle mb-0">
                                    <thead class="table-light">
                                        <tr>
                                            <th style="width: 45px;" class="text-center">#</th>
                                            <% if (todoSubFields.length > 0) { %>
                                                <% todoSubFields.forEach(sub => { %>
                                                    <th><%= sub.fieldName %></th>
                                                <% }) %>
                                            <% } else { %>
                                                <th>Nội dung công việc</th>
                                                <th style="width: 140px;">Trạng thái</th>
                                                <th style="width: 170px;">Thời gian</th>
                                            <% } %>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        <% todoItems.forEach((item, idx) => { %>
                                            <tr>
                                                <td class="text-center text-muted"><%= idx + 1 %></td>
                                                <% if (todoSubFields.length > 0) { %>
                                                    <% todoSubFields.forEach(sub => { %>
                                                        <% const val = item[sub.fieldKey]; %>
                                                        <% if (sub.fieldKey === 'taskName' || sub.fieldKey === 'name') { %>
                                                            <td class="fw-medium"><%= val || '-' %></td>
                                                        <% } else { %>
                                                            <td class="text-muted small"><%= val || '-' %></td>
                                                        <% } %>
                                                    <% }) %>
                                                <% } else { %>
                                                    <td class="fw-medium"><%= item.taskName || item.todoName || item.title || item.name || '-' %></td>
                                                    <td class="text-muted small"><%= item.taskDate || item.createdAt || item.time || '-' %></td>
                                                <% } %>
                                            </tr>
                                        <% }) %>
                                    </tbody>
                                </table>
                            </div>
                        <% } else { %>
                            <p class="text-muted small mb-0 fst-italic">Chưa có dữ liệu việc thực hiện.</p>
                        <% } %>
                    </div>
                </div>
            </div>

        <% } else { %>
            <!-- ========================================== -->
            <!-- ========================================== -->
            <!-- TRUY XUẤT MỞ RỘNG (EXTERNAL) - THEO EXTERNAL_WHITELIST -->
            <!-- ========================================== -->

            <!-- Thẻ 1: Thông tin nhà sản xuất (MANUFACTURER) -->
            <div class="card border-0 shadow-sm mb-4">
                <div class="card-header bg-white py-3 border-bottom d-flex align-items-center d-none">
                    <div class="icon-box me-3">
                        <i class="fa fa-industry fa-lg"></i>
                    </div>
                    <h5 class="mb-0 fw-bold text-dark">Thông tin nhà sản xuất</h5>
                </div>
                <div class="card-body p-3 p-md-4">
                    <div class="row g-3">
                        <div class="col-12">
                            <div class="field-container">
                                <div class="field-label text-muted small">Tên nhà sản xuất</div>
                                <div class="field-value fw-bold fs-6">
                                    <%= compact.facilityName || compact.personInCharge || '-' %>
                                </div>
                            </div>
                        </div>
                        <div class="col-12">
                            <div class="field-container">
                                <div class="field-label text-muted small">Địa chỉ</div>
                                <div class="field-value">
                                    <%= compact.facilityAddress || '-' %>
                                </div>
                            </div>
                        </div>

                        <% const certVal = compact.mCertificationFile || compact.fiCertificationFile; %>
                        <% if (certVal) { %>
                            <% 
                                let certFiles = [];
                                if (Array.isArray(certVal)) {
                                    certFiles = certVal.map(f => typeof f === 'object' ? f?.url : f).filter(Boolean);
                                } else if (certVal) {
                                    const singleUrl = typeof certVal === 'object' ? certVal?.url : certVal;
                                    if (singleUrl) certFiles.push(singleUrl);
                                }
                            %>
                            <% if (certFiles.length > 0) { %>
                                <div class="col-12">
                                    <div class="field-container">
                                        <div class="field-label text-muted small mb-2">Hồ sơ pháp lý</div>
                                        <div class="d-flex flex-wrap gap-2">
                                            <% certFiles.forEach(function(fileUrl, idx) { %>
                                                <a href="/<%= fileUrl %>" target="_blank" class="btn btn-sm btn-outline-primary py-1 px-3 d-inline-flex align-items-center">
                                                    <i class="fa fa-file-alt me-2"></i>Xem file chứng nhận <%= certFiles.length > 1 ? (idx + 1) : '' %>
                                                    <i class="fa fa-external-link-alt ms-2 small"></i>
                                                </a>
                                            <% }); %>
                                        </div>
                                    </div>
                                </div>
                            <% } %>
                        <% } %>
                    </div>
                </div>
            </div>

            <!-- Thẻ 2: Nguồn gốc sản phẩm (ORIGIN_NEST) -->
            <div class="card border-0 shadow-sm mb-4">
                <div class="card-header bg-white py-3 border-bottom d-flex align-items-center d-none">
                    <div class="icon-box me-3">
                        <i class="fa fa-warehouse fa-lg"></i>
                    </div>
                    <h5 class="mb-0 fw-bold text-dark">Nguồn gốc sản phẩm</h5>
                </div>
                <div class="card-body p-3 p-md-4">
                    <div class="row g-3">
                        <div class="col-12">
                            <div class="field-container">
                                <div class="field-label text-muted small">Sản phẩm thu hoạch tại:</div>
                                <div class="field-value fs-6 fw-bold text-dark">
                                    <%= compact.onAddressArea || compact.facilityAddress || '-' %>
                                </div>
                            </div>
                        </div>

                        <div class="col-12">
                            <div class="field-container">
                                <div class="field-label text-muted small">Ngày thu hoạch</div>
                                <div class="field-value fw-bold">
                                    <%= compact.onHarvestDate || compact.hiHarvestDate %>
                                </div>
                            </div>
                        </div>

                        <% if (compact.onWeightingPhoto) { %>
                            <% const photoUrl = typeof compact.onWeightingPhoto === 'object' ? compact.onWeightingPhoto?.url : compact.onWeightingPhoto; %>
                            <% if (photoUrl) { %>
                                <div class="col-12 mt-3">
                                    <div class="field-label text-muted small mb-2 fw-bold">Hình ảnh thu hoạch:</div>
                                    <a href="/<%= photoUrl %>" target="_blank" class="d-block text-center">
                                        <img src="/<%= photoUrl %>" alt="Ảnh cân tổ yến" class="img-thumbnail rounded shadow-sm w-100" style="max-height: 380px; object-fit: contain;">
                                    </a>
                                </div>
                            <% } %>
                        <% } %>
                    </div>
                </div>
            </div>

            <!-- Thẻ 3: Nhật ký Sơ chế & Chế biến (PRE_PROCESSING) -->
            <div class="card border-0 shadow-sm mb-4">
                <div class="card-header bg-white py-3 border-bottom d-flex align-items-center d-none">
                    <div class="icon-box me-3">
                        <i class="fa fa-industry fa-lg"></i>
                    </div>
                    <h5 class="mb-0 fw-bold text-dark">Sơ chế & Chế biến</h5>
                </div>
                <div class="card-body p-3 p-md-4">
                    <h6 class="fw-bold text-primary mb-3 d-flex align-items-center">
                        <i class="fa fa-stream me-2"></i> Nhật ký các công đoạn
                    </h6>

                    <% const stages = compact.diaryProcessGroup?.loopValues; %>
                    <% if (Array.isArray(stages) && stages.length > 0) { %>
                        <div class="row g-3">
                            <% stages.forEach((stage, sIdx) => { %>
                                <div class="col-12">
                                    <div class="card border bg-light p-3 shadow-none mb-2 rounded-3">
                                        <div class="d-flex flex-wrap align-items-center justify-content-between gap-2 border-bottom pb-2 mb-3">
                                            <span class="fw-bold text-success fs-6">
                                                <i class="fa fa-tasks me-1"></i> Công đoạn <%= sIdx + 1 %>: <%= stage.dpProcessName || 'Không tên' %>
                                            </span>
                                        </div>

                                        <div class="row g-3">
                                            <div class="col-12">
                                                <div class="d-flex flex-column gap-2 small">
                                                    <% if (stage.dpProcessTime) { %>
                                                        <div>
                                                            <span class="text-muted"><i class="fa fa-calendar-alt me-1 text-secondary"></i> Ngày thực hiện:</span>
                                                            <strong class="text-dark ms-1"><%= stage.dpProcessTime %></strong>
                                                        </div>
                                                    <% } %>
                                                    <% if (stage.dpProcesser) { %>
                                                         <div>
                                                            <span class="text-muted"><i class="fa fa-user me-1 text-secondary"></i> Người thực hiện:</span>
                                                            <span class="text-dark ms-1"><%= stage.dpProcesser %></span>
                                                         </div>
                                                    <% } %>

                                                    <% if (stage.dpAddress) { %>
                                                        <div>
                                                            <span class="text-muted"><i class="fa fa-map-marker-alt me-1 text-secondary"></i> Địa điểm:</span>
                                                            <span class="text-dark ms-1"><%= stage.dpAddress %></span>
                                                        </div>
                                                    <% } %>

                                                    <% if (stage.dpNote) { %>
                                                        <div>
                                                            <span class="text-muted"><i class="fa fa-sticky-note me-1 text-secondary"></i> Ghi chú:</span>
                                                            <span class="text-dark ms-1 fst-italic"><%= stage.dpNote %></span>
                                                        </div>
                                                    <% } %>
                                                </div>
                                            </div>

                                            <% const fileVal = stage.dpProcessFile; %>
                                            <% const fileUrl = typeof fileVal === 'object' ? fileVal?.url : fileVal; %>
                                            <% if (fileUrl) { %>
                                                <div class="col-12">
                                                    <div class="field-label text-muted small mb-1">Ảnh công đoạn:</div>
                                                    <a href="/<%= fileUrl %>" target="_blank" class="d-inline-block">
                                                        <img src="/<%= fileUrl %>" alt="Ảnh công đoạn" class="img-thumbnail rounded shadow-sm" style="max-height: 160px; max-width: 100%; object-fit: contain;">
                                                    </a>
                                                </div>
                                            <% } %>
                                        </div>
                                    </div>
                                </div>
                            <% }) %>
                        </div>
                    <% } else { %>
                        <p class="text-muted small mb-0 fst-italic">Chưa có dữ liệu công đoạn sơ chế.</p>
                    <% } %>
                </div>
            </div>

            <!-- Thẻ 4: Thông tin sản phẩm (PACKING_QR) -->
            <div class="card border-0 shadow-sm mb-4">
                <div class="card-header bg-white py-3 border-bottom d-flex align-items-center d-none">
                    <div class="icon-box me-3">
                        <i class="fa fa-box-open fa-lg"></i>
                    </div>
                    <h5 class="mb-0 fw-bold text-dark">Thông tin sản phẩm</h5>
                </div>
                <div class="card-body p-3 p-md-4">
                    <div class="row g-3">
                        <div class="col-12">
                            <div class="field-container">
                                <div class="field-label text-muted small">Thành phần</div>
                                <div class="field-value fw-bold text-dark" style="white-space: pre-line;">
                                    <%= compact.iiIngredients || '-' %>
                                </div>
                            </div>
                        </div>
                        <div class="col-12">
                            <div class="field-container">
                                <div class="field-label text-muted small">Tiêu chuẩn áp dụng</div>
                                <div class="field-value fw-bold text-success" style="white-space: pre-line;">
                                    <%= compact.iiApplicableStandard || '-' %>
                                </div>
                            </div>
                        </div>
                        <div class="col-12">
                            <div class="field-container">
                                <div class="field-label text-muted small">Hướng dẫn sử dụng</div>
                                <div class="field-value" style="white-space: pre-line;">
                                    <%= compact.iiInstructionUse || '-' %>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

        <% } %>

        <!-- Footer / Thông tin bản quyền -->
        <div class="text-center py-4 text-muted small">
            <p class="mb-1">© <%= new Date().getFullYear() %> Hệ thống Quản trị & Truy xuất sản phẩm 3FAM</p>
            <p class="mb-0">Dữ  liệu truy xuất nguồn gốc tổ yến do chủ nhà Yến cung cấp và chịu trách nhiệm.</p>
        </div>
    </div>
</div>

<% } else { %>
<div class="trace-container py-5 text-center" style="max-width: 600px; margin: 0 auto;">
    <div class="alert alert-warning text-center shadow-sm p-4 rounded-4">
        <i class="fa fa-exclamation-triangle fa-3x mb-3 text-warning"></i>
        <h4 class="fw-bold">Không tìm thấy dữ liệu Truy xuất nguồn gốc</h4>
        <p class="mb-0 text-muted">Vui lòng kiểm tra lại liên kết hoặc mã QR tra cứu của bạn.</p>
    </div>
</div>
<% } %>