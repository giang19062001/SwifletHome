<% if (values && values.traceData) { %>
<% const data = values.traceData; %>
<% const isExternal = Boolean(data.isExternal); %>
<% const compact = data.compactData %>

<div class="page-qrcode-update py-3 py-md-4" id="qrcode-global-content">
    <!-- Nút tải PDF nổi góc dưới màn hình -->
    <!-- <div class="pdf-floating-btn" data-html2canvas-ignore="true">
        <a
            href="/api/app/traceability/downloadPdf/<%= data.traceabilityId %>"
            class="btn btn-danger shadow-lg rounded-pill px-4 py-2 d-flex align-items-center text-white text-decoration-none"
            id="btn-download-pdf"
        >
            <i class="fa fa-file-pdf me-2 fa-lg"></i>
            <span class="fw-bold">Tải bản PDF</span>
        </a>
    </div> -->

    <div class="trace-container" style="max-width: 900px; margin: 0 auto; padding: 0 16px;">
        <!-- Banner Header: Định danh & Huy hiệu xác thực -->
        <div class="card border-0 shadow-sm overflow-hidden mb-4" style="background: linear-gradient(135deg, #71AB33 0%, #4B7A1C 100%);">
            <div class="card-body p-4 text-white">
                <div class="d-flex flex-wrap align-items-center justify-content-between gap-3">
                    <div class="d-flex align-items-center">
                        <div class="bg-white text-success rounded-circle p-3 d-flex align-items-center justify-content-center me-3 shadow-sm" style="width: 58px; height: 58px;">
                            <i class="fa fa-shield-alt fa-2x" style="color: #71AB33;"></i>
                        </div>
                        <div>
                            <span class="badge bg-white text-success fw-bold px-2 py-1 mb-1">
                                <i class="fa fa-check-circle me-1"></i> ĐÃ XÁC THỰC HỆ THỐNG
                            </span>
                            <h3 class="mb-0 fw-bold fs-4 text-white">XÁC THỰC TRUY XUẤT NGUỒN GỐC</h3>
                            <p class="mb-0 text-white-50 small">Hồ sơ điện tử truy xuất yến sào 3FAM</p>
                        </div>
                    </div>
                    <div>
                        <a href="/api/app/traceability/downloadPdf/<%= data.traceabilityId %>" class="btn btn-light text-success fw-bold px-3 py-2 rounded-pill shadow-sm">
                            <i class="fa fa-file-pdf me-1 text-danger"></i> Xuất chứng nhận PDF
                        </a>
                    </div>
                </div>

                <hr class="my-3 border-white opacity-25">

                <div class="row g-2 text-white small">
                    <div class="col-12 col-md-6">
                        <span class="text-white-50">Mã tra cứu TXNG:</span>
                        <span class="fw-bold ms-1 text-break"><%= data.traceabilityId %></span>
                    </div>
                    <div class="col-12 col-md-6">
                        <span class="text-white-50">Mã lô sản phẩm:</span>
                        <span class="fw-bold ms-1 text-warning"><%= data.lotcode || compact.lotcode || 'Chưa cập nhật' %></span>
                    </div>
                </div>
            </div>
        </div>

        <% if (!isExternal) { %>
            <!-- ========================================== -->
            <!-- TRUY XUẤT NỘI BỘ (INTERNAL) -->
            <!-- ========================================== -->

            <!-- Thẻ 1: Thông tin cơ sở sản xuất -->
            <div class="card border-0 shadow-sm mb-4">
                <div class="card-header bg-white py-3 border-bottom d-flex align-items-center">
                    <div class="icon-box me-3">
                        <i class="fa fa-home fa-lg"></i>
                    </div>
                    <h5 class="mb-0 fw-bold text-dark">Thông tin cơ sở sản xuất</h5>
                </div>
                <div class="card-body p-3 p-md-4">
                    <div class="row g-3">
                        <div class="col-md-6 col-12">
                            <div class="field-container">
                                <div class="field-label text-muted small">Tên cơ sở (nhà yến)</div>
                                <div class="field-value fw-bold fs-6">
                                    <%= compact.facilityName || data.homeInfo?.userHomeName || '-' %>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-6 col-12">
                            <div class="field-container">
                                <div class="field-label text-muted small">Mã định danh cơ sở</div>
                                <div class="field-value fw-bold fs-6 text-primary">
                                    <%= compact.fiIdentificationCode || '-' %>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-6 col-12">
                            <div class="field-container">
                                <div class="field-label text-muted small">Địa chỉ sản xuất</div>
                                <div class="field-value">
                                    <%= compact.facilityAddress || data.homeInfo?.userHomeAddress || '-' %>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-6 col-12">
                            <div class="field-container">
                                <div class="field-label text-muted small">Mã lô thu hoạch</div>
                                <div class="field-value fw-bold text-dark">
                                    <%= compact.lotcode || data.lotcode || '-' %>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Thẻ 2: Thông tin thu hoạch -->
            <div class="card border-0 shadow-sm mb-4">
                <div class="card-header bg-white py-3 border-bottom d-flex align-items-center">
                    <div class="icon-box me-3">
                        <i class="fa fa-boxes fa-lg"></i>
                    </div>
                    <h5 class="mb-0 fw-bold text-dark">Thông tin thu hoạch</h5>
                </div>
                <div class="card-body p-3 p-md-4">
                    <div class="row g-3">
                        <div class="col-md-4 col-12">
                            <div class="field-container">
                                <div class="field-label text-muted small">Số đợt thu hoạch</div>
                                <div class="field-value fw-bold fs-6">
                                    <%= Array.isArray(compact.hiNumberHarvest) ? compact.hiNumberHarvest.join(', ') : (compact.hiNumberHarvest || '-') %>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-4 col-12">
                            <div class="field-container">
                                <div class="field-label text-muted small">Số lượng tổ</div>
                                <div class="field-value fw-bold fs-6">
                                    <%= (compact.hmNumberNests !== null && compact.hmNumberNests !== undefined && compact.hmNumberNests !== '') ? compact.hmNumberNests + ' tổ' : '-' %>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-4 col-12">
                            <div class="field-container">
                                <div class="field-label text-muted small">Khối lượng thu hoạch</div>
                                <div class="field-value fw-bold fs-6 text-success">
                                    <%= (compact.hmWeight !== null && compact.hmWeight !== undefined && compact.hmWeight !== '') ? compact.hmWeight + ' gram' : '-' %>
                                </div>
                            </div>
                        </div>

                        <% if (compact.hmWeightingPhoto) { %>
                            <% const photoUrl = typeof compact.hmWeightingPhoto === 'object' ? compact.hmWeightingPhoto?.url : compact.hmWeightingPhoto; %>
                            <% if (photoUrl) { %>
                                <div class="col-12 mt-3">
                                    <div class="field-label text-muted small mb-2">Ảnh cân thu hoạch:</div>
                                    <a href="/<%= photoUrl %>" target="_blank" class="d-inline-block">
                                        <img src="/<%= photoUrl %>" alt="Ảnh cân thu hoạch" class="img-thumbnail rounded shadow-sm" style="max-height: 180px; object-fit: contain;">
                                    </a>
                                </div>
                            <% } %>
                        <% } %>
                    </div>
                </div>
            </div>

            <!-- Thẻ 3: Nhật ký nhà yến (Công việc & Lăn thuốc) -->
            <div class="card border-0 shadow-sm mb-4">
                <div class="card-header bg-white py-3 border-bottom d-flex align-items-center">
                    <div class="icon-box me-3">
                        <i class="fa fa-book fa-lg"></i>
                    </div>
                    <h5 class="mb-0 fw-bold text-dark">Nhật ký nhà yến</h5>
                </div>
                <div class="card-body p-3 p-md-4">
                    <!-- 1. Các việc đã thực hiện (SWIFT_HOUSE_TD) -->
                    <div class="mb-4">
                        <h6 class="fw-bold text-primary mb-3 d-flex align-items-center">
                            <i class="fa fa-tasks me-2"></i> 1. Các việc đã thực hiện
                        </h6>
                        <% const todoField = compact.todoListGroup?.fields?.find(f => (f.fieldKey || '').toLowerCase().includes('todo') || f.fieldType === 'list_readonly'); %>
                        <% const todoItems = todoField?.currentValue; %>
                        <% const todoSubFields = (todoField?.config && (Array.isArray(todoField.config.maps) ? todoField.config.maps : (Array.isArray(todoField.config.fields) ? todoField.config.fields : []))) || []; %>
                        <% if (Array.isArray(todoItems) && todoItems.length > 0) { %>
                            <div class="table-responsive">
                                <table class="table table-bordered table-sm align-middle mb-0">
                                    <thead class="table-light">
                                        <tr>
                                            <th style="width: 45px;" class="text-center">#</th>
                                            <% if (todoSubFields.length > 0) { %>
                                                <% todoSubFields.forEach(sub => { %>
                                                    <th><%= sub.fieldName %></th>
                                                <% }) %>
                                            <% } else { %>
                                                <th>Nội dung công việc</th>
                                                <th style="width: 140px;">Trạng thái</th>
                                                <th style="width: 170px;">Thời gian</th>
                                            <% } %>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        <% todoItems.forEach((item, idx) => { %>
                                            <tr>
                                                <td class="text-center text-muted"><%= idx + 1 %></td>
                                                <% if (todoSubFields.length > 0) { %>
                                                    <% todoSubFields.forEach(sub => { %>
                                                        <% const val = item[sub.fieldKey]; %>
                                                        <% if (sub.fieldKey === 'taskStatus' || sub.fieldKey === 'status' || sub.fieldKey === 'todoStatus') { %>
                                                            <td><span class="badge bg-light text-dark border"><%= val || '-' %></span></td>
                                                        <% } else if (sub.fieldKey === 'taskName' || sub.fieldKey === 'name') { %>
                                                            <td class="fw-medium"><%= val || '-' %></td>
                                                        <% } else { %>
                                                            <td class="text-muted small"><%= val || '-' %></td>
                                                        <% } %>
                                                    <% }) %>
                                                <% } else { %>
                                                    <td class="fw-medium"><%= item.taskName || item.todoName || item.title || item.name || '-' %></td>
                                                    <td>
                                                        <span class="badge bg-light text-dark border">
                                                            <%= item.taskStatus || item.todoStatus || item.status || '-' %>
                                                        </span>
                                                    </td>
                                                    <td class="text-muted small"><%= item.taskDate || item.createdAt || item.time || '-' %></td>
                                                <% } %>
                                            </tr>
                                        <% }) %>
                                    </tbody>
                                </table>
                            </div>
                        <% } else { %>
                            <p class="text-muted small mb-0 fst-italic">Chưa có dữ liệu việc thực hiện.</p>
                        <% } %>
                    </div>

                    <hr class="my-4">

                    <!-- 2. Lịch sử lăn thuốc (SWIFT_HOUSE_MEDICINE) -->
                    <div>
                        <h6 class="fw-bold text-primary mb-3 d-flex align-items-center">
                            <i class="fa fa-spray-can me-2"></i> 2. Lịch sử lăn thuốc
                        </h6>
                        <% const medField = compact.medicineGroup?.fields?.find(f => (f.fieldKey || '').toLowerCase().includes('medicine') || f.fieldType === 'list_readonly'); %>
                        <% const medItems = medField?.currentValue; %>
                        <% const medSubFields = (medField?.config && (Array.isArray(medField.config.maps) ? medField.config.maps : (Array.isArray(medField.config.fields) ? medField.config.fields : []))) || []; %>
                        <% if (Array.isArray(medItems) && medItems.length > 0) { %>
                            <div class="table-responsive">
                                <table class="table table-bordered table-sm align-middle mb-0">
                                    <thead class="table-light">
                                        <tr>
                                            <th style="width: 45px;" class="text-center">#</th>
                                            <% if (medSubFields.length > 0) { %>
                                                <% medSubFields.forEach(sub => { %>
                                                    <th><%= sub.fieldName %></th>
                                                <% }) %>
                                            <% } else { %>
                                                <th>Tên thuốc</th>
                                                <th style="width: 140px;">Liều lượng</th>
                                                <th style="width: 170px;">Ngày thực hiện</th>
                                            <% } %>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        <% medItems.forEach((item, idx) => { %>
                                            <tr>
                                                <td class="text-center text-muted"><%= idx + 1 %></td>
                                                <% if (medSubFields.length > 0) { %>
                                                    <% medSubFields.forEach(sub => { %>
                                                        <% const val = item[sub.fieldKey]; %>
                                                        <% if (sub.fieldKey === 'valueOption' || sub.fieldKey === 'medicineName' || sub.fieldKey === 'name') { %>
                                                            <td class="fw-medium"><%= val || '-' %></td>
                                                        <% } else { %>
                                                            <td><%= val || '-' %></td>
                                                        <% } %>
                                                    <% }) %>
                                                <% } else { %>
                                                    <td class="fw-medium"><%= item.valueOption || item.medicineName || item.name || '-' %></td>
                                                    <td><%= item.medicineUsage || item.dosage || '-' %></td>
                                                    <td class="text-muted small"><%= item.createdAt || item.date || '-' %></td>
                                                <% } %>
                                            </tr>
                                        <% }) %>
                                    </tbody>
                                </table>
                            </div>
                        <% } else { %>
                            <p class="text-muted small mb-0 fst-italic">Chưa có dữ liệu lăn thuốc.</p>
                        <% } %>
                    </div>
                </div>
            </div>

        <% } else { %>
            <!-- ========================================== -->
            <!-- TRUY XUẤT MỞ RỘNG (EXTERNAL) -->
            <!-- ========================================== -->

            <!-- Thẻ 1: Thông tin cơ sở & thu hoạch ban đầu (formDataExtra) -->
            <div class="card border-0 shadow-sm mb-4">
                <div class="card-header bg-white py-3 border-bottom d-flex align-items-center">
                    <div class="icon-box me-3">
                        <i class="fa fa-warehouse fa-lg"></i>
                    </div>
                    <h5 class="mb-0 fw-bold text-dark">Thông tin cơ sở & Thu hoạch ban đầu</h5>
                </div>
                <div class="card-body p-3 p-md-4">
                    <% const extra = compact.formDataExtra || data.formDataExtra || {}; %>
                    <div class="row g-3">
                        <div class="col-md-6 col-12">
                            <div class="field-container">
                                <div class="field-label text-muted small">Mã lô liên kết</div>
                                <div class="field-value fw-bold text-success fs-6">
                                    <%= compact.lotcode || data.lotcode || '-' %>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-6 col-12">
                            <div class="field-container">
                                <div class="field-label text-muted small">Mã định danh cơ sở (Bộ NN cấp)</div>
                                <div class="field-value fw-bold text-primary">
                                    <%= extra.fiIdentificationCode || '-' %>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-6 col-12">
                            <div class="field-container">
                                <div class="field-label text-muted small">Tên cơ sở (nhà yến)</div>
                                <div class="field-value fw-bold">
                                    <%= extra.facilityName || '-' %>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-6 col-12">
                            <div class="field-container">
                                <div class="field-label text-muted small">Địa chỉ cơ sở</div>
                                <div class="field-value">
                                    <%= extra.facilityAddress || '-' %>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-4 col-12">
                            <div class="field-container">
                                <div class="field-label text-muted small">Thời gian hoạt động</div>
                                <div class="field-value">
                                    <%= extra.facilityActiveTime || '-' %>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-4 col-12">
                            <div class="field-container">
                                <div class="field-label text-muted small">Diện tích cơ sở</div>
                                <div class="field-value">
                                    <%= extra.facilityArea ? extra.facilityArea : '-' %>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-2 col-6">
                            <div class="field-container">
                                <div class="field-label text-muted small">Số tầng</div>
                                <div class="field-value">
                                    <%= (extra.facilityFloor !== undefined && extra.facilityFloor !== null && extra.facilityFloor !== '') ? extra.facilityFloor : '-' %>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-2 col-6">
                            <div class="field-container">
                                <div class="field-label text-muted small">Số lượng tổ</div>
                                <div class="field-value fw-bold">
                                    <%= (extra.hmNumberNests !== undefined && extra.hmNumberNests !== null && extra.hmNumberNests !== '') ? extra.hmNumberNests : '-' %>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Thẻ 2: Tiếp nhận nguyên liệu & Sơ chế (PRE_PROCESSING) -->
            <div class="card border-0 shadow-sm mb-4">
                <div class="card-header bg-white py-3 border-bottom d-flex align-items-center">
                    <div class="icon-box me-3">
                        <i class="fa fa-industry fa-lg"></i>
                    </div>
                    <h5 class="mb-0 fw-bold text-dark">Tiếp nhận & Sơ chế nguyên liệu</h5>
                </div>
                <div class="card-body p-3 p-md-4">
                    <div class="row g-3 mb-4">
                        <div class="col-md-6 col-12">
                            <div class="field-container">
                                <div class="field-label text-muted small">Cơ sở thực hiện sơ chế</div>
                                <div class="field-value fw-bold fs-6">
                                    <%= compact.rmTeamExecution || '-' %>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-6 col-12">
                            <div class="field-container">
                                <div class="field-label text-muted small">Địa chỉ cơ sở sơ chế</div>
                                <div class="field-value">
                                    <%= compact.rmAddress || '-' %>
                                </div>
                            </div>
                        </div>
                    </div>

                    <h6 class="fw-bold text-primary mb-3 d-flex align-items-center">
                        <i class="fa fa-stream me-2"></i> Nhật ký công đoạn sơ chế
                    </h6>

                    <% const stages = compact.diaryProcessGroup?.loopValues; %>
                    <% if (Array.isArray(stages) && stages.length > 0) { %>
                        <div class="row g-3">
                            <% stages.forEach((stage, sIdx) => { %>
                                <div class="col-12">
                                    <div class="card border bg-light p-3 shadow-none mb-2">
                                        <div class="d-flex flex-wrap align-items-center justify-content-between gap-2 border-bottom pb-2 mb-2">
                                            <span class="fw-bold text-success fs-6">
                                                <i class="fa fa-check-circle me-1"></i> Công đoạn <%= sIdx + 1 %>: <%= stage.dpProcessName || 'Không tên' %>
                                            </span>
                                            <span class="text-muted small">
                                                <i class="fa fa-user me-1"></i> <%= stage.dpProcesser || 'Người thực hiện: -' %>
                                            </span>
                                        </div>
                                        <div class="row g-2 align-items-center">
                                            <div class="col-md-8 col-12">
                                                <div class="small text-muted mb-1">
                                                    <i class="fa fa-clock me-1"></i> <strong>Thời gian:</strong> 
                                                    <%= stage.dpProcessStartTime || '-' %> 
                                                    <% if (stage.dpProcessEndTime) { %>
                                                        đến <%= stage.dpProcessEndTime %>
                                                    <% } %>
                                                </div>
                                            </div>
                                            <% const fileVal = stage.dpProcessFile; %>
                                            <% const fileUrl = typeof fileVal === 'object' ? fileVal?.url : fileVal; %>
                                            <% if (fileUrl) { %>
                                                <div class="col-md-4 col-12 text-md-end">
                                                    <a href="/<%= fileUrl %>" target="_blank" class="d-inline-block">
                                                        <img src="/<%= fileUrl %>" alt="Ảnh công đoạn" class="img-thumbnail rounded shadow-sm" style="max-height: 80px; object-fit: contain;">
                                                    </a>
                                                </div>
                                            <% } %>
                                        </div>
                                    </div>
                                </div>
                            <% }) %>
                        </div>
                    <% } else { %>
                        <p class="text-muted small mb-0 fst-italic">Chưa có dữ liệu công đoạn sơ chế.</p>
                    <% } %>
                </div>
            </div>

            <!-- Thẻ 3: Thông tin sản phẩm & Đóng gói (PACKING_QR) -->
            <div class="card border-0 shadow-sm mb-4">
                <div class="card-header bg-white py-3 border-bottom d-flex align-items-center">
                    <div class="icon-box me-3">
                        <i class="fa fa-box-open fa-lg"></i>
                    </div>
                    <h5 class="mb-0 fw-bold text-dark">Thông tin sản phẩm & Đóng gói</h5>
                </div>
                <div class="card-body p-3 p-md-4">
                    <div class="row g-3">
                        <div class="col-md-6 col-12">
                            <div class="field-container">
                                <div class="field-label text-muted small">Tên sản phẩm</div>
                                <div class="field-value fw-bold fs-6 text-primary">
                                    <%= compact.pcProductName || '-' %>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-6 col-12">
                            <div class="field-container">
                                <div class="field-label text-muted small">Quy cách cơ bản</div>
                                <div class="field-value">
                                    <%= compact.pcBasicSpecification || '-' %>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-6 col-12">
                            <div class="field-container">
                                <div class="field-label text-muted small">Tiêu chuẩn áp dụng</div>
                                <div class="field-value fw-bold text-success">
                                    <%= compact.iiApplicableStandard || '-' %>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-6 col-12">
                            <div class="field-container">
                                <div class="field-label text-muted small">Hướng dẫn sử dụng</div>
                                <div class="field-value">
                                    <%= compact.iiInstructionUse || '-' %>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

        <% } %>

        <!-- Footer / Thông tin bản quyền -->
        <div class="text-center py-4 text-muted small">
            <p class="mb-1">© <%= new Date().getFullYear() %> Hệ thống Quản trị & Truy xuất Yến sào 3FAM</p>
            <p class="mb-0">Chứng nhận xác thực nguồn gốc điện tử chính thức</p>
        </div>
    </div>
</div>

<% } else { %>
<div class="trace-container py-5 text-center" style="max-width: 600px; margin: 0 auto;">
    <div class="alert alert-warning text-center shadow-sm p-4 rounded-4">
        <i class="fa fa-exclamation-triangle fa-3x mb-3 text-warning"></i>
        <h4 class="fw-bold">Không tìm thấy dữ liệu Truy xuất nguồn gốc</h4>
