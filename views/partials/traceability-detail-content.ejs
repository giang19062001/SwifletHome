<% if (values && values.traceData) { %>
<div class="page-qrcode-update py-4" id="pdf-content">
    <div class="pdf-floating-btn" data-html2canvas-ignore="true">
        <a
            href="/api/app/traceability/downloadFullPdf/<%= values.traceData.traceabilityId %>"
            id="btn-download-pdf"
            class="btn btn-danger shadow-lg rounded-pill px-4 py-2 d-flex align-items-center text-white text-decoration-none"
            style="<%= (typeof showPdfButton !== 'undefined' && showPdfButton) ? '' : 'display: none !important;' %>"
        >
            <i class="fa fa-file-pdf me-2 fa-lg"></i>
            <span class="fw-bold">Tải bản PDF</span>
        </a>
    </div>
    <div class="trace-container">
        <!-- Thông tin chung của nhà yến -->
        <% if (values.traceData.homeInfo) { %>
        <div class="row mb-4">
            <div class="col-12">
                <div class="card border-0 shadow-sm overflow-hidden">
                    <div class="card-header bg-primary text-white py-3">
                        <h4 class="mb-0 fw-bold d-flex align-items-center">
                            <i class="fa fa-home me-2"></i> Thông tin cơ sở chính
                        </h4>
                    </div>
                    <div class="card-body">
                        <div class="row g-3">
                            <div class="col-md-6">
                                <div class="d-flex align-items-center">
                                    <div class="icon-box bg-light text-primary p-3 rounded me-3" style="width: 50px; height: 50px; display: flex; align-items: center; justify-content: center;">
                                        <i class="fa fa-qrcode fa-lg"></i>
                                    </div>
                                    <div>
                                        <div class="text-muted small">Mã Truy xuất nguồn gốc:</div>
                                        <div class="fw-bold text-break"><%= values.traceData.traceabilityId %></div>
                                    </div>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="d-flex align-items-center">
                                    <div class="icon-box bg-light text-primary p-3 rounded me-3" style="width: 50px; height: 50px; display: flex; align-items: center; justify-content: center;">
                                        <i class="fa fa-home fa-lg"></i>
                                    </div>
                                    <div>
                                        <div class="text-muted small">Tên nhà yến:</div>
                                        <div class="fw-bold"><%= values.traceData.homeInfo.userHomeName %></div>
                                    </div>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="d-flex align-items-center">
                                    <div class="icon-box bg-light text-primary p-3 rounded me-3" style="width: 50px; height: 50px; display: flex; align-items: center; justify-content: center;">
                                        <i class="fa fa-user fa-lg"></i>
                                    </div>
                                    <div>
                                        <div class="text-muted small">Chủ sở hữu:</div>
                                        <div class="fw-bold"><%= values.traceData.homeInfo.userName %></div>
                                    </div>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="d-flex align-items-center">
                                    <div class="icon-box bg-light text-primary p-3 rounded me-3" style="width: 50px; height: 50px; display: flex; align-items: center; justify-content: center;">
                                        <i class="fa fa-map-marker-alt fa-lg"></i>
                                    </div>
                                    <div>
                                        <div class="text-muted small">Địa chỉ sản xuất:</div>
                                        <div class="fw-bold"><%= values.traceData.homeInfo.userHomeAddress %></div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <% } %>

        <!-- Các biểu mẫu truy xuất nguồn gốc -->
        <div class="card border-0 shadow-sm overflow-hidden mb-4">
            <div class="card-header bg-primary text-white py-3">
                <h4 class="mb-0 fw-bold d-flex align-items-center">
                    <i class="fa fa-file-alt me-2"></i> Nhật ký biểu mẫu truy xuất nguồn gốc
                </h4>
            </div>
            <div class="card-body bg-light p-3">
                <div class="row g-3">
                    <% values.traceData.forms.forEach((form, idx) => { %>
                        <div class="col-12">
                            <div class="card border-0 shadow-sm overflow-hidden h-100 mb-3">
                                <div class="card-header bg-white py-3 border-bottom d-flex flex-wrap align-items-center justify-content-between gap-2">
                                    <div>
                                        <h5 class="form-title mb-1">
                                            <%= idx + 1 %>. <%= form.formName %>
                                        </h5>
                                        <% if (form.formDescription) { %>
                                            <p class="form-description mb-0"><%= form.formDescription %></p>
                                        <% } %>
                                    </div>
                                </div>
                                <div class="card-body">
                                    <% if (form.hasData) { %>
                                        <div class="row g-3">
                                            <% form.submission.groups.forEach(group => { %>
                                                <div class="col-12">
                                                    <h6 class="group-title">
                                                        <% if (group.groupName && group.groupName.trim() !== '') { %>
                                                            <i class="fa fa-caret-right me-1"></i> <%= group.groupName %>
                                                        <% } %>
                                                    </h6>
                                                    <% if (group.isLoop === 'Y' && group.loopValues && group.loopValues.length > 0) { %>
                                                        <div class="d-flex flex-column gap-3 mt-2">
                                                            <% group.loopValues.forEach((stage, sIdx) => { %>
                                                                <div class="card border rounded-3 p-3 shadow-none bg-light bg-opacity-25">
                                                                    <div class="fw-semibold text-primary mb-2">
                                                                        <i class="fa fa-layer-group me-1"></i> <%= (group.loopMetadata && group.loopMetadata.title) ? group.loopMetadata.title : 'Công đoạn' %> <%= sIdx + 1 %>
                                                                    </div>
                                                                    <div class="row g-2">
                                                                        <% group.fields.forEach(field => { %>
                                                                            <% if (field.fieldType === 'link_download') return; %>
                                                                            <% const val = stage[field.fieldKey]; %>
                                                                            <div class="col-md-6 col-12">
                                                                                <div class="field-container">
                                                                                    <div class="field-label"><%= field.fieldName %></div>
                                                                                    <div class="field-value">
                                                                                        <% if (field.fieldType === 'file_single') { %>
                                                                                            <% const fileUrl = (val && typeof val === 'object' && val.url) ? val.url : (typeof val === 'string' ? val : null); %>
                                                                                            <% if (fileUrl) { %>
                                                                                                <% const isImg = fileUrl.toLowerCase().match(/\.(jpg|jpeg|png|webp|gif)$/); %>
                                                                                                <% const isVideo = fileUrl.toLowerCase().match(/\.(mp4|mov|webm)$/); %>
                                                                                                <% if (isImg) { %>
                                                                                                    <a href="/<%= fileUrl %>" target="_blank" class="d-inline-block mt-2">
                                                                                                        <img src="/<%= fileUrl %>" class="img-thumbnail rounded shadow-sm" style="max-height: 120px;" alt="<%= field.fieldName %>">
                                                                                                    </a>
                                                                                                <% } else if (isVideo) { %>
                                                                                                    <div class="mt-2">
                                                                                                        <video src="/<%= fileUrl %>" controls class="rounded shadow-sm" style="max-height: 200px; max-width: 100%;"></video>
                                                                                                    </div>
                                                                                                <% } else { %>
                                                                                                    <a href="/<%= fileUrl %>" target="_blank" class="btn btn-sm btn-outline-primary mt-2">
                                                                                                        <i class="fa fa-file-download me-1"></i> Tải tài liệu
                                                                                                    </a>
                                                                                                <% } %>
                                                                                            <% } else { %>
                                                                                                <span class="text-muted small">Chưa có tệp đính kèm</span>
                                                                                            <% } %>
                                                                                        <% } else if (field.fieldType === 'file_multiple') { %>
                                                                                            <% if (Array.isArray(val) && val.length > 0) { %>
                                                                                                <div class="d-flex flex-wrap gap-2 mt-2">
                                                                                                    <% val.forEach(file => { %>
                                                                                                        <% const fileUrl = (file && typeof file === 'object' && file.url) ? file.url : (typeof file === 'string' ? file : null); %>
                                                                                                        <% if (fileUrl) { %>
                                                                                                            <% const isImg = fileUrl.toLowerCase().match(/\.(jpg|jpeg|png|webp|gif)$/); %>
                                                                                                            <% const isVideo = fileUrl.toLowerCase().match(/\.(mp4|mov|webm)$/); %>
                                                                                                            <% if (isImg) { %>
                                                                                                                <a href="/<%= fileUrl %>" target="_blank" class="d-inline-block">
                                                                                                                    <img src="/<%= fileUrl %>" class="img-thumbnail rounded shadow-sm" style="max-height: 80px;" alt="<%= field.fieldName %>">
                                                                                                                </a>
                                                                                                            <% } else if (isVideo) { %>
                                                                                                                <div class="d-inline-block">
                                                                                                                    <video src="/<%= fileUrl %>" controls class="rounded shadow-sm" style="max-height: 120px; max-width: 100%;"></video>
                                                                                                                </div>
                                                                                                            <% } else { %>
                                                                                                                <a href="/<%= fileUrl %>" target="_blank" class="btn btn-sm btn-outline-primary">
                                                                                                                    <i class="fa fa-file-download me-1"></i> Tải tài liệu
                                                                                                                </a>
                                                                                                            <% } %>
                                                                                                        <% } %>
                                                                                                    <% }) %>
                                                                                                </div>
                                                                                            <% } else { %>
                                                                                                <span class="text-muted small">Chưa có tệp đính kèm</span>
                                                                                            <% } %>
                                                                                        <% } else { %>
                                                                                            <%
                                                                                                let listItems = val;
                                                                                                if (typeof listItems === 'string' && (listItems.trim().startsWith('[') || listItems.trim().startsWith('{'))) {
                                                                                                    try { listItems = JSON.parse(listItems); } catch(e) {}
                                                                                                }
                                                                                                const isTable = field.fieldType === 'list_canwrite' || (Array.isArray(listItems) && listItems.length > 0 && typeof listItems[0] === 'object' && listItems[0] !== null && !listItems[0].url);
                                                                                            %>
                                                                                            <% if (isTable) { %>
                                                                                                <%
                                                                                                    let subFields = [];
                                                                                                    let conf = field.config;
                                                                                                    if (typeof conf === 'string') {
                                                                                                        try { conf = JSON.parse(conf); } catch (e) { conf = {}; }
                                                                                                    }
                                                                                                    if (conf) {
                                                                                                        if (Array.isArray(conf.maps)) subFields = conf.maps;
                                                                                                        else if (Array.isArray(conf.fields)) subFields = conf.fields;
                                                                                                        else if (Array.isArray(conf.columns)) subFields = conf.columns;
                                                                                                    }
                                                                                                    if ((!subFields || subFields.length === 0) && Array.isArray(listItems) && listItems.length > 0) {
                                                                                                        const keyMap = new Map();
                                                                                                        listItems.forEach(it => {
                                                                                                            if (it && typeof it === 'object') {
                                                                                                                Object.keys(it).forEach(k => {
                                                                                                                    if (!keyMap.has(k)) {
                                                                                                                        keyMap.set(k, { fieldKey: k, fieldName: k });
                                                                                                                    }
                                                                                                                });
                                                                                                            }
                                                                                                        });
                                                                                                        subFields = Array.from(keyMap.values());
                                                                                                    }
                                                                                                %>
                                                                                                <% if (Array.isArray(listItems) && listItems.length > 0 && subFields.length > 0) { %>
                                                                                                    <div class="table-responsive mt-2">
                                                                                                        <table class="table table-bordered table-sm mb-0">
                                                                                                            <thead class="table-light">
                                                                                                                <tr>
                                                                                                                    <th style="width: 40px; text-align: center;">#</th>
                                                                                                                    <% subFields.forEach(sub => { %>
                                                                                                                        <th><%= sub.fieldName || sub.label || sub.fieldKey %></th>
                                                                                                                    <% }) %>
                                                                                                                </tr>
                                                                                                            </thead>
                                                                                                            <tbody>
                                                                                                                <% listItems.forEach((item, itemIdx) => { %>
                                                                                                                    <tr>
                                                                                                                        <td class="text-center align-top"><%= itemIdx + 1 %></td>
                                                                                                                        <% subFields.forEach(sub => { %>
                                                                                                                            <td class="align-top" style="white-space: pre-line;"><%= (item && typeof item === 'object') ? (item[sub.fieldKey] ?? item[sub.key] ?? '-') : (item ?? '-') %></td>
                                                                                                                        <% }) %>
                                                                                                                    </tr>
                                                                                                                <% }) %>
                                                                                                            </tbody>
                                                                                                        </table>
                                                                                                    </div>
                                                                                                <% } else { %>
                                                                                                    <span class="text-muted small">Không có dữ liệu</span>
                                                                                                <% } %>
                                                                                            <% } else { %>
                                                                                                <% if (val !== null && val !== undefined && val !== '') { %>
                                                                                                    <% if (Array.isArray(val)) { %>
                                                                                                        <span style="white-space: pre-line;"><%= val.map(v => (typeof v === 'object' && v !== null ? (v.label || v.name || v.title || v.value || JSON.stringify(v)) : v)).join(', ') %></span>
                                                                                                    <% } else if (typeof val === 'object' && val !== null) { %>
                                                                                                        <span style="white-space: pre-line;"><%= val.label || val.name || val.title || val.value || JSON.stringify(val) %></span>
                                                                                                    <% } else { %>
                                                                                                        <span style="white-space: pre-line;"><%= val %></span>
                                                                                                    <% } %>
                                                                                                <% } else { %>
                                                                                                    <span class="text-muted small">-</span>
                                                                                                <% } %>
                                                                                            <% } %>
                                                                                        <% } %>
                                                                                    </div>
                                                                                </div>
                                                                            </div>
                                                                        <% }) %>
                                                                    </div>
                                                                </div>
                                                            <% }) %>
                                                        </div>
                                                    <% } else if (group.isLoop === 'Y') { %>
                                                        <div class="alert alert-light border text-muted small py-2 mb-0 mt-2">
                                                            Chưa có dữ liệu ghi nhận.
                                                        </div>
                                                    <% } else { %>
                                                    <div class="row g-2">
                                                        <% group.fields.forEach(field => { %>
                                                            <% if (field.fieldType === 'link_download') return; %>
                                                            <div class="col-md-6 col-12">
                                                                <div class="field-container">
                                                                    <div class="field-label"><%= field.fieldName %></div>
                                                                    <div class="field-value">
                                                                        <% if (field.fieldType === 'file_single') { %>
                                                                            <% const fileUrl = (field.currentValue && typeof field.currentValue === 'object' && field.currentValue.url) ? field.currentValue.url : (typeof field.currentValue === 'string' ? field.currentValue : null); %>
                                                                            <% if (fileUrl) { %>
                                                                                <% const isImg = fileUrl.toLowerCase().match(/\.(jpg|jpeg|png|webp|gif)$/); %>
                                                                                <% const isVideo = fileUrl.toLowerCase().match(/\.(mp4|mov|webm)$/); %>
                                                                                <% if (isImg) { %>
                                                                                    <a href="/<%= fileUrl %>" target="_blank" class="d-inline-block mt-2">
                                                                                        <img src="/<%= fileUrl %>" class="img-thumbnail rounded shadow-sm" style="max-height: 120px;" alt="<%= field.fieldName %>">
                                                                                    </a>
                                                                                <% } else if (isVideo) { %>
                                                                                    <div class="mt-2">
                                                                                        <video src="/<%= fileUrl %>" controls class="rounded shadow-sm" style="max-height: 200px; max-width: 100%;"></video>
                                                                                    </div>
                                                                                <% } else { %>
                                                                                    <a href="/<%= fileUrl %>" target="_blank" class="btn btn-sm btn-outline-primary mt-2">
                                                                                        <i class="fa fa-file-download me-1"></i> Tải tài liệu
                                                                                    </a>
                                                                                <% } %>
                                                                            <% } else { %>
                                                                                <span class="text-muted small">Chưa có tệp đính kèm</span>
                                                                            <% } %>
                                                                        <% } else if (field.fieldType === 'file_multiple') { %>
                                                                            <% if (field.currentValue && field.currentValue.length > 0) { %>
                                                                                <div class="d-flex flex-wrap gap-2 mt-2">
                                                                                    <% field.currentValue.forEach(file => { %>
                                                                                        <% const fileUrl = (file && typeof file === 'object' && file.url) ? file.url : (typeof file === 'string' ? file : null); %>
                                                                                        <% if (fileUrl) { %>
                                                                                            <% const isImg = fileUrl.toLowerCase().match(/\.(jpg|jpeg|png|webp|gif)$/); %>
                                                                                            <% const isVideo = fileUrl.toLowerCase().match(/\.(mp4|mov|webm)$/); %>
                                                                                            <% if (isImg) { %>
                                                                                                <a href="/<%= fileUrl %>" target="_blank" class="d-inline-block">
                                                                                                    <img src="/<%= fileUrl %>" class="img-thumbnail rounded shadow-sm" style="max-height: 80px;" alt="<%= field.fieldName %>">
                                                                                                </a>
                                                                                            <% } else if (isVideo) { %>
                                                                                                <div class="d-inline-block">
                                                                                                    <video src="/<%= fileUrl %>" controls class="rounded shadow-sm" style="max-height: 120px; max-width: 100%;"></video>
                                                                                                </div>
                                                                                            <% } else { %>
                                                                                                <a href="/<%= fileUrl %>" target="_blank" class="btn btn-sm btn-outline-primary">
                                                                                                    <i class="fa fa-file-download me-1"></i> Tải tài liệu
                                                                                                </a>
                                                                                            <% } %>
                                                                                        <% } %>
                                                                                    <% }) %>
                                                                                </div>
                                                                            <% } else { %>
                                                                                <span class="text-muted small">Chưa có tệp đính kèm</span>
                                                                            <% } %>
                                                                        <% } else { %>
                                                                            <%
                                                                                let listItems = field.currentValue;
                                                                                if (typeof listItems === 'string' && (listItems.trim().startsWith('[') || listItems.trim().startsWith('{'))) {
                                                                                    try { listItems = JSON.parse(listItems); } catch(e) {}
                                                                                }
                                                                                const isTable = field.fieldType === 'list_canwrite' || (Array.isArray(listItems) && listItems.length > 0 && typeof listItems[0] === 'object' && listItems[0] !== null && !listItems[0].url);
                                                                            %>
                                                                            <% if (isTable) { %>
                                                                                <%
                                                                                    let subFields = [];
                                                                                    let conf = field.config;
                                                                                    if (typeof conf === 'string') {
                                                                                        try { conf = JSON.parse(conf); } catch (e) { conf = {}; }
                                                                                    }
                                                                                    if (conf) {
                                                                                        if (Array.isArray(conf.maps)) subFields = conf.maps;
                                                                                        else if (Array.isArray(conf.fields)) subFields = conf.fields;
                                                                                        else if (Array.isArray(conf.columns)) subFields = conf.columns;
                                                                                    }
                                                                                    if ((!subFields || subFields.length === 0) && Array.isArray(listItems) && listItems.length > 0) {
                                                                                        const keyMap = new Map();
                                                                                        listItems.forEach(it => {
                                                                                            if (it && typeof it === 'object') {
                                                                                                Object.keys(it).forEach(k => {
                                                                                                    if (!keyMap.has(k)) {
                                                                                                        keyMap.set(k, { fieldKey: k, fieldName: k });
                                                                                                    }
                                                                                                });
                                                                                            }
                                                                                        });
                                                                                        subFields = Array.from(keyMap.values());
                                                                                    }
                                                                                %>
                                                                                <% if (Array.isArray(listItems) && listItems.length > 0 && subFields.length > 0) { %>
                                                                                    <div class="table-responsive mt-2">
                                                                                        <table class="table table-bordered table-sm mb-0">
                                                                                            <thead class="table-light">
                                                                                                <tr>
                                                                                                    <th style="width: 40px; text-align: center;">#</th>
                                                                                                    <% subFields.forEach(sub => { %>
                                                                                                        <th><%= sub.fieldName || sub.label || sub.fieldKey %></th>
                                                                                                    <% }) %>
                                                                                                </tr>
                                                                                            </thead>
                                                                                            <tbody>
                                                                                                <% listItems.forEach((item, itemIdx) => { %>
                                                                                                    <tr>
                                                                                                        <td class="text-center align-top"><%= itemIdx + 1 %></td>
                                                                                                        <% subFields.forEach(sub => { %>
                                                                                                            <td class="align-top" style="white-space: pre-line;"><%= (item && typeof item === 'object') ? (item[sub.fieldKey] ?? item[sub.key] ?? '-') : (item ?? '-') %></td>
                                                                                                        <% }) %>
                                                                                                    </tr>
                                                                                                <% }) %>
                                                                                            </tbody>
                                                                                        </table>
                                                                                    </div>
                                                                                <% } else { %>
                                                                                    <span class="text-muted small">Không có dữ liệu</span>
                                                                                <% } %>
                                                                            <% } else { %>
                                                                                <% if (field.currentValue !== null && field.currentValue !== undefined && field.currentValue !== '') { %>
                                                                                    <% if (Array.isArray(field.currentValue)) { %>
                                                                                        <span style="white-space: pre-line;"><%= field.currentValue.map(v => (typeof v === 'object' && v !== null ? (v.label || v.name || v.title || v.value || JSON.stringify(v)) : v)).join(', ') %></span>
                                                                                    <% } else if (typeof field.currentValue === 'object' && field.currentValue !== null) { %>
                                                                                        <span style="white-space: pre-line;"><%= field.currentValue.label || field.currentValue.name || field.currentValue.title || field.currentValue.value || JSON.stringify(field.currentValue) %></span>
                                                                                    <% } else { %>
                                                                                        <span style="white-space: pre-line;"><%= field.currentValue %></span>
                                                                                    <% } %>
                                                                                <% } else { %>
                                                                                    <span class="text-muted small">Chưa nhập thông tin</span>
                                                                                <% } %>
                                                                            <% } %>
                                                                        <% } %>
                                                                    </div>
                                                                </div>
                                                            </div>
                                                        <% }) %>
                                                    </div>
                                                    <% } %>
                                                </div>
                                            <% }) %>
                                        </div>
                                    <% } else { %>
                                        <div class="alert alert-light border text-center py-4 mb-0">
                                            <i class="fa fa-info-circle text-muted me-2"></i> Chưa có dữ liệu ghi nhận cho biểu mẫu này.
                                        </div>
                                    <% } %>
                                </div>
                            </div>
                        </div>
                    <% }) %>
                </div>
            </div>
        </div>
    </div>

    <script>
        // document.addEventListener('DOMContentLoaded', function() {
        //     const btn = document.getElementById('btn-download-pdf');
        //     if (btn) {
        //         btn.addEventListener('click', function() {
        //             window.location.href = '/api/app/traceability/downloadFullPdf/<%= values.traceData.traceabilityId %>';
        //         });
        //     }
        // });
    </script>
</div>
<% } else { %>
<div class="trace-container py-5">
    <div class="alert alert-warning text-center shadow-sm">
        <i class="fa fa-exclamation-triangle fa-2x mb-3 text-warning"></i>
        <h4>Không tìm thấy dữ liệu Truy xuất nguồn gốc</h4>
        <p class="mb-0 text-muted">Vui lòng kiểm tra lại liên kết hoặc mã QR của bạn.</p>
    </div>
</div>
<% } %>
